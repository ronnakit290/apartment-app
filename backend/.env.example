# Copy to backend/.env (Bun loads it automatically) and fill in.
PORT=3000
DB_PATH=data.sqlite

# Cloudflare Turnstile — set BOTH to turn on bot protection for
# login, first-run setup and the public "book a viewing" form.
# Leave empty to disable. Keys: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
